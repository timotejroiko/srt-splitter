{
	"name": "srt-splitter",
	"version": "0.2.0",
	"description": "High-performance SRT splitter: one upstream SRT source fanned out to many SRT clients",
	"main": "index.js",
	"bin": {
		"srt-splitter": "index.js"
	},
	"type": "commonjs",
	"files": [
		"config.js",
		"index.js",
		"prebuilds",
		"scripts",
		"src"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"start": "node index.js",
		"prebuild": "node scripts/prebuild.js",
		"setup": "node scripts/setup.js"
	},
	"devDependencies": {
		"@eyevinn/srt": "git+https://github.com/Eyevinn/node-srt.git#0dfdb40dde2a2d81b1fc79e5d3cb3cf1076db465"
	}
}
